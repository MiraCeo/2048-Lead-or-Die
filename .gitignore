# Python 字节码缓存
__pycache__/
*.py[cod]

# tools/format_engine.py 的临时区（拼接后的完整脚本、prettier 输出）
/.fmt/

# 可再生的构建产物：由 `python tools/build_engine.py` 从交付文件重新生成，
# 仓库里保留的就是上一次改动的旧引擎，容易误导（项目文档 §14.2 第③条踩过这个坑）。
# 注意：build/baseline/ 与 build/reference/ **必须保留** —— 前者是 build.py 的
# 比对基线（--accept 写入），后者是步骤 0 的逐字节原始参照，忽略它们会让构建校验失去意义。
/build/engine*.js
/build/core-fleet.engine.js
# §6 那次相位诊断的 A/B 变体，由 `python tools/build_variant.py --position <相位> --out ...`
# 按需生成，共 1.6MB 近重复内容；现役工具链不引用。
/build/variants/

# 失败的 headless Chrome 残留（沙箱内起不来，见项目文档 §14.7 第 1 条）
/build/chrome-profile*/
/build/cp3/

# 差异测试的临时产物。
# **必须保留** build/difftest/base.{manifest.json,turns.jsonl} —— 它是重构前的
# 行为基线，是 `tools/difftest.js --assert-same` 的判据，丢了就无法证明重构等价。
# 其余全是可随时用 --out 别的名字重跑的中间产物：
#   - mutants/   tools/mutate.js 生成的 210KB 引擎副本（反向验证工具有效性用）
#   - selfcheck  工具自校验那次运行
#   - phase1/phase2  阶段 1、阶段 2 的验收运行（结论已记在项目文档与提交信息里）
# 所以采用「白名单」写法：只放行 base.*，其余一律忽略。
/build/difftest/*
!/build/difftest/base.manifest.json
!/build/difftest/base.turns.jsonl

# 阶段 2 的一次性快照：拆分前的 main.script.js 原始副本。
# 它只用于证明"重建逐字节相同"，而 `git diff --stat -- src/main.script.js` 为空
# 是更直接的同等证据，所以不必长期保留。
/build/reference/main.script.original.js
